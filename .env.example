# RabbitMQ Configuration (CloudAMQP)
# Obtenha as credenciais em: https://www.cloudamqp.com/
RABBITMQ_USERNAME=seu_usuario_cloudamqp
RABBITMQ_PASSWORD=sua_senha_cloudamqp

# Gmail SMTP Configuration
# Use App Password ao invés da senha da conta: https://support.google.com/accounts/answer/185833
EMAIL_USERNAME=seu_email@gmail.com
EMAIL_PASSWORD=sua_app_password_16_caracteres

# Optional: Configurações adicionais
# Database credentials (se não usar Docker Compose)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Server ports (padrão)
USER_SERVICE_PORT=8081
EMAIL_SERVICE_PORT=8080

# Database URLs
USER_DB_URL=jdbc:postgresql://localhost:5435/ms-user-ms
EMAIL_DB_URL=jdbc:postgresql://localhost:5433/ms_email_ms

# RabbitMQ Queue
RABBITMQ_QUEUE_NAME=email-queue
RABBITMQ_EXCHANGE_NAME=user-exchange
RABBITMQ_ROUTING_KEY=user.email.send

